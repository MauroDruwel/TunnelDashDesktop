{
  "name": "tunneldash",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "Tiny Cloudflare Tunnel sidekick with native SSH terminal launching (Tauri + React)",
  "author": "Mauro Druwel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MauroDruwel/TunnelDashDesktop.git"
  },
  "homepage": "https://github.com/MauroDruwel/TunnelDashDesktop#readme",
  "bugs": {
    "url": "https://github.com/MauroDruwel/TunnelDashDesktop/issues"
  },
  "keywords": [
    "cloudflare",
    "tunnel",
    "cloudflared",
    "ssh",
    "tauri",
    "zero-trust"
  ],
  "scripts": {
    "dev": "vite",
